<%# Card di anteprima di un articolo. Per convenzione di Rails, `render @articles` (o `render @article`)
    cerca questo file (articles/_article) e crea da solo la variabile locale `article`. %>
<article class="card">
  <%= link_to article, class: "card__cover cover-#{article.id % 4}#{' card__cover--photo' if article.cover_image.attached?}",
        tabindex: -1, "aria-hidden": true do %>
    <% if article.cover_image.attached? %>
      <%= render "articles/cover", article: article %>
    <% else %>
      <%= render "shared/ball", size: 84 %>   <%# senza copertina: il pallone di prima %>
    <% end %>
  <% end %>
  <div class="card__body">
    <p class="card__meta">
      <time><%= article_date(article) %></time>
      <% if article.location.present? %>· <%= article.location %><% end %>
    </p>
    <h3 class="card__title"><%= link_to article.title, article %></h3>
    <% if article.categories.any? %>
      <p class="chips"><% article.categories.each do |category| %><span class="chip"><%= category.name %></span><% end %></p>
    <% end %>
    <p class="card__excerpt"><%= article.excerpt.presence || truncate(article.body, length: 140) %></p>
    <div class="card__foot">
      <span><%= reading_time(article) %></span>
      <%= link_to "Leggi →", article, class: "card__more" %>
    </div>
  </div>
</article>
