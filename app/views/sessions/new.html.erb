<% content_for :title, "Accedi" %>

<header class="page-head">
  <div class="container">
    <p class="kicker">Area riservata</p>
    <h1 class="page-head__title">Accedi</h1>
  </div>
</header>

<section class="section container container--narrow">
  <%# Nessun modello: la sessione non è un oggetto Active Record. L'invio va a session_path (risorsa singolare). %>
  <%= form_with(url: session_path, local: true, class: "form") do |form| %>
    <div class="field">
      <%= form.label :email, "Email" %>
      <%= form.text_field :email, value: params[:email], autocomplete: "email", autofocus: true %>
    </div>

    <div class="field">
      <%= form.label :password, "Password" %>
      <%= form.password_field :password, autocomplete: "current-password" %>
    </div>

    <div class="actions">
      <%= form.submit "Accedi", class: "btn btn--primary btn--lg" %>
      <%= link_to "Annulla", root_path, class: "link-more" %>
    </div>
  <% end %>
  <p class="form-note">Non hai un account? <%= link_to "Registrati", new_user_path %></p>
</section>
