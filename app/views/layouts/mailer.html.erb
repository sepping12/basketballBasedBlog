<!DOCTYPE html>
<html lang="it">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
  </head>
  <%# Gli stili sono scritti nei tag (style="…"): molti client di posta ignorano i fogli di stile e i CSS moderni. %>
  <body style="margin:0;padding:24px 12px;background:#fbf7f0;font-family:Arial,Helvetica,sans-serif;color:#14110f;line-height:1.6;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width:560px;margin:0 auto;">
      <tr>
        <td style="background:#14110f;color:#ffffff;padding:16px 24px;border-radius:12px 12px 0 0;font-size:22px;letter-spacing:1px;">
          <span style="color:#f2631a;">●</span> FAST BREAK
        </td>
      </tr>
      <tr>
        <td style="background:#ffffff;padding:24px;border:1px solid #e8dfd2;border-top:0;border-radius:0 0 12px 12px;font-size:16px;">
          <%= yield %>
        </td>
      </tr>
      <tr>
        <td style="padding:12px 24px;font-size:12px;color:#6f655c;text-align:center;">
          Messaggio inviato da Fast Break · il basket raccontato da chi lo ama
        </td>
      </tr>
    </table>
  </body>
</html>
