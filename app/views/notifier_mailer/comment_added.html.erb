<p>
  <strong><%= @comment.name %></strong> ha commentato il tuo articolo
  <em><%= @article.title %></em>:
</p>
<blockquote style="margin:16px 0;padding:8px 16px;border-left:4px solid #f2631a;color:#6f655c;">
  <%= simple_format(truncate(@comment.body, length: 300)) %>
</blockquote>
<p>
  <%= link_to "Leggi e rispondi", article_url(@article, anchor: "commenti"),
        style: "display:inline-block;padding:10px 20px;background:#f2631a;color:#ffffff;text-decoration:none;border-radius:999px;font-weight:bold;" %>
</p>
